<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="book_list" model="ir.ui.view">
        <field name="name">practice.library.book.list</field>
        <field name="model">practice.library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author"/>
                <field name="price"/>
                <field name="pages"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>
    <record id="book_form" model="ir.ui.view">
        <field name="name">practice.library.book.form</field>
        <field name="model">practice.library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="price"/>
                        <field name="pages"/>
                        <field name="date_added"/>
                        <field name="is_read"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">practice.library.book</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="library_root" name="Practice Library" sequence="20" groups="base.group_user"/>
    <menuitem id="library_books" name="Books" parent="library_root" action="book_action"/>
</odoo>
