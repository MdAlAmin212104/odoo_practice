<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_employee_leave_expire" model="ir.cron">
        <field name="name">Update leave requests status</field>
        <field name="model_id" ref="model_employee_leave_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_expired_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
        <field name="active">True</field>
    </record>
</odoo>
