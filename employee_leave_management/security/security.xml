<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_leave_management" model="ir.module.category">
        <field name="name">Leave Management</field>
        <field name="description">Roles for the employee leave management module.</field>
    </record>

    <record id="group_leave_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_leave_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_leave_employee'))]"/>
    </record>

    <record id="group_leave_hr" model="res.groups">
        <field name="name">HR</field>
        <field name="implied_ids" eval="[(4, ref('group_leave_manager'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_leave_employee'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_leave_hr'))]"/>
    </record>

    <record id="rule_leave_request_employee_own" model="ir.rule">
        <field name="name">Employee can see own leave requests</field>
        <field name="model_id" ref="model_employee_leave_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_leave_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_leave_request_manager_team" model="ir.rule">
        <field name="name">Manager can see team leave requests</field>
        <field name="model_id" ref="model_employee_leave_request"/>
        <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_leave_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_leave_request_hr_all" model="ir.rule">
        <field name="name">HR can see all leave requests</field>
        <field name="model_id" ref="model_employee_leave_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_leave_hr'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
