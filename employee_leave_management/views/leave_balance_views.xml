<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_leave_balance_list" model="ir.ui.view">
        <field name="name">employee.leave.balance.list</field>
        <field name="model">employee.leave.balance</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="year"/>
                <field name="total_days"/>
                <field name="used_days"/>
                <field name="remaining_days"/>
            </list>
        </field>
    </record>

    <record id="view_employee_leave_balance_form" model="ir.ui.view">
        <field name="name">employee.leave.balance.form</field>
        <field name="model">employee.leave.balance</field>
        <field name="arch" type="xml">
            <form string="Leave Balance">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="leave_type_id"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="total_days"/>
                            <field name="used_days"/>
                            <field name="remaining_days" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
