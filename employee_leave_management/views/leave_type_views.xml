<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_leave_type_list" model="ir.ui.view">
        <field name="name">employee.leave.type.list</field>
        <field name="model">employee.leave.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="max_days"/>
                <field name="paid"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_employee_leave_type_form" model="ir.ui.view">
        <field name="name">employee.leave.type.form</field>
        <field name="model">employee.leave.type</field>
        <field name="arch" type="xml">
            <form string="Leave Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="max_days"/>
                        </group>
                        <group>
                            <field name="paid"/>
                            <field name="active"/>
                            <field name="color"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <group>
                                <field name="requires_manager_approval"/>
                                <field name="requires_hr_approval"/>
                                <field name="description"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
