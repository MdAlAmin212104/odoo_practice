<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_rejection_wizard_form" model="ir.ui.view">
        <field name="name">employee.leave.rejection.wizard.form</field>
        <field name="model">employee.leave.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Leave Request">
                <group>
                    <field name="rejection_reason" placeholder="Enter rejection reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection" type="object" string="Confirm Rejection" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
