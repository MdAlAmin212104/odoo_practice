<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="address"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="date_available"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="expected_price"/>
                            <field name="date_available"/>
                        </group>
                        <group>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="garden"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first property</p>
        </field>
    </record>

    <menuitem id="estate_menu_root" name="Real Estate" sequence="10" groups="base.group_user"/>
    <menuitem id="estate_property_menu" name="Properties" parent="estate_menu_root"
              action="estate_property_action" sequence="10"/>
</odoo>
